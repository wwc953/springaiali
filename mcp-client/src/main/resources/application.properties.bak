spring.application.name=mcp-client
spring.main.web-application-type=none
spring.ai.dashscope.agent.api-key=${DASHSCOPE_API_KEY}
spring.ai.mcp.client.enabled=true
spring.ai.mcp.client.name=my-mcp-client
spring.ai.mcp.client.version=1.0.0
spring.ai.mcp.client.request-timeout=30s
spring.ai.mcp.client.type=async

spring.ai.alibaba.mcp.nacos.client.enabled=true
spring.ai.alibaba.mcp.nacos.client.streamable.connections.server1.service-name=webflux-mcp-server
spring.ai.alibaba.mcp.nacos.client.streamable.connections.server1.version=1.0.0
spring.ai.alibaba.mcp.nacos.client.configs.server1.namespace=4ad3108b-4d44-43d0-9634-3c1ac4850c8c
spring.ai.alibaba.mcp.nacos.client.configs.server1.server-addr=127.0.0.1:8848
spring.ai.alibaba.mcp.nacos.client.configs.server1.username=nacos
spring.ai.alibaba.mcp.nacos.client.configs.server1.password=nacos